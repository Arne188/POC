<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hooked Ad Assistant 3.2" android:textSize="26sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Erkennt typische Weiter- und Schliessen-Elemente, markiert den Zielbereich und erinnert lautlos." />
<Switch android:id="@+id/masterSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Assistant ein oder aus" android:textStyle="bold" />
<Button android:id="@+id/openAccessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Bedienungshilfe oeffnen" />
<Switch android:id="@+id/treeDetectionSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="UI-Erkennung" />
<Switch android:id="@+id/screenDetectionSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lokale X-Erkennung per Screenshot" />
<Switch android:id="@+id/overlaySwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Spotlight: Ziel markieren und Rest abdunkeln" />
<Switch android:id="@+id/timerSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Timer-Fallback 35 s und 55 s" />
<Switch android:id="@+id/vibrateSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vibration" />
<Button android:id="@+id/testNotificationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Lautlosen Hinweis testen" />
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Status" android:textStyle="bold" />
<TextView android:id="@+id/statsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Statistik" />
<Button android:id="@+id/resetStatsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Statistik zuruecksetzen" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Das Spotlight ist nicht klickbar und laesst deine Eingabe an die darunterliegende Werbung durch. Es verschwindet automatisch wieder." android:textSize="13sp" />
</LinearLayout>
</ScrollView>
